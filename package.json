{
  "name": "kassandra",
  "version": "1.5.0",
  "private": true,
  "description": "Web-based GUI client for Apache Cassandra",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w @kassandra/server\" \"npm run dev -w @kassandra/client\"",
    "build": "npm run build -w @kassandra/shared && npm run build -w @kassandra/server && npm run build -w @kassandra/client",
    "start": "npm run start -w @kassandra/server",
    "typecheck": "npm run typecheck --ws --if-present",
    "test": "npm run test --ws --if-present",
    "clean": "npm run clean --ws --if-present && rm -rf node_modules"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^9.3.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.1.2",
    "postcss": "^8.5.32",
    "vite": "^8.3.3"
  }
}
